# ============================================================
# ONE OF A KIND FASHION — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

NODE_ENV=development

# --- MongoDB ---
# Local: mongodb://127.0.0.1:27017/one-of-a-kind-fashion
# Atlas: mongodb+srv://USER:PASS@CLUSTER/one-of-a-kind-fashion
# Transactions require a replica set or Atlas cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/one-of-a-kind-fashion

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated if you open the site via LAN IP (phone/tablet preview)
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Next.js (public — safe for browser) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Session / Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
COOKIE_NAME=ookf_session
COOKIE_SECURE=false

# --- Initial Admin (used by pnpm create-admin) ---
ADMIN_INITIAL_EMAIL=owner@oneofakindfashion.local
ADMIN_INITIAL_PASSWORD=ChangeMeNow!123

# --- Stripe (Canadian CAD) — leave blank until keys are available ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudinary (product images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Resend or SMTP provider key) ---
EMAIL_PROVIDER_KEY=
EMAIL_FROM=orders@oneofakindfashion.local
